{
  "name": "schedule-provider",
  "version": "5.0.0",
  "description": "Gets and parses a schedule for lotta.",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist/*",
    "build": "swc src -d dist --strip-leading-paths",
    "dev:start": "npm-run-all clean build start",
    "dev": "nodemon --watch src -e ts --exec npm run dev:start",
    "start": "node --require ./dist/tracing.js dist/index",
    "test": "jest",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/medienportal/schedule-provider.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/medienportal/schedule-provider/issues"
  },
  "homepage": "https://gitlab.com/medienportal/schedule-provider#readme",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@sentry/node": "^10.48.0",
    "axios": "^1.15.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@swc/jest": "^0.2.39",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/nock": "^11.1.0",
    "@types/supertest": "^7.2.0",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "nock": "^14.0.12",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.2",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.1.3",
    "superagent": "^10.3.0",
    "supertest": "^7.2.2",
    "tslint": "^6.1.3",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
